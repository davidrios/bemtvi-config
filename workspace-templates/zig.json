{
  "languages": {
    "zig,zir": {
      "lsps": {
        "zls": {}
      },
      "save_actions": [
        {
          "require": "btv.lsp",
          "method": "code_action",
          "params": { "context": { "only": ["source.fixAll"] }, "apply": true }
        },
        {
          "require": "btv.lsp",
          "method": "code_action",
          "params": { "context": { "only": ["source.organizeImports"] }, "apply": true }
        },
        { "require": "btv.lsp", "method": "format", "params": { "name": "zls" } }
      ]
    }
  },

  "setup": { "require": "workspace-setup.zig", "method": "setup" }
}
